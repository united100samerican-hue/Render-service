# Copy this file to .env and paste the CURRENT production values exactly.
# NEVER commit .env.

API_ID=
API_HASH=

# services/audio gives AUDIO_SESSION_STRING priority over SESSION_STRING.
# Keep the current production value in AUDIO_SESSION_STRING.
AUDIO_SESSION_STRING=
SESSION_STRING=

BOT_TOKEN=
KEEPALIVE_SECRET=

# YouTube / yt-dlp
YOUTUBE_COOKIES=
YOUTUBE_PROXY=

# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET=audio-cache
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGN_SECONDS=86400

# PORT is fixed to the current service default through compose.
# Do not add variables belonging to services/YouTube or services/tiktok here.
